      "localized": {
        "en-US": {
          "description": "<p><b>Drop a pin, walk back to the exact spot.</b> Mark where you left the car on level 3, where the trailhead was, where the tent is. Hours or weeks later, open the pin and walk: one arrow, one distance, no map tiles, no signal needed.</p>\n<ul>\n<li><b>Follow-back arrow</b> to true north, corrected for magnetic declination.</li>\n<li><b>Honest accuracy:</b> every pin carries the radius you may have to search.</li>\n<li><b>Sharpen a pin</b> by standing on the spot again.</li>\n<li><b>Photos and voice notes</b> on pins, folders, and a home-screen widget.</li>\n<li><b>Retrace your exact path</b>, and get guided with the screen off.</li>\n<li><b>Radar</b> of the pins around you, live elevation and sunset warnings.</li>\n<li><b>Share as seven words</b> or a QR code; back up, restore and move pins to other map apps.</li>\n<li><b>App lock</b> and home-screen shortcuts.</li>\n</ul>\n",
          "featureGraphic": "featureGraphic_WsT_TUKh_jWcayWpxuGier4r-PnSh4G6zAhCCv_lq04=.png",
          "icon": "icon_oMJb21OPsS_4junko3ONjmonF3IYol3qzqxLVlzxJs0=.png",
          "name": "Loadstone",
          "phoneScreenshots": [
            "1.png",
            "2.png",
            "3.png",
            "4.png"
          ],
          "summary": "Drop a pin, walk back to the exact spot. No map or signal needed",
          "whatsNew": "\u2022 Website and contact links in About.\n"
        }
      }
    },
