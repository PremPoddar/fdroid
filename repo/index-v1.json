      "packageName": "com.prempoddar.campfire",
      "lastUpdated": 1793729825000,
      "localized": {
        "en-US": {
          "description": "<p><b>One phone hosts. Everyone else opens a link. No accounts, no internet, nothing left behind.</b></p>\n<p>Start a Campfire on your phone and it shows a link and a QR code. Anyone on the same Wi-Fi, or connected to your hotspot, opens it in any browser, picks a name and is chatting. When you end it, every message, room and file is gone.</p>\n<ul>\n<li><b>Public room</b> that everyone lands in, plus rooms anyone can start, optionally with a password.</li>\n<li><b>Direct messages</b> with anyone there.</li>\n<li><b>Replies and reactions</b>; edit or delete your own messages.</li>\n<li><b>Polls, pins</b> and muting.</li>\n<li><b>Voice notes</b> from the app or the browser.</li>\n<li><b>Read receipts, typing and presence.</b></li>\n<li><b>Files</b> of any kind and size; photos and videos play inline.</li>\n<li><b>Link previews</b> fetched by the host phone, so everyone sees them.</li>\n<li><b>Moderation:</b> room creators remove people from their rooms; the host can remove anyone.</li>\n<li><b>Save the chat</b> before the fire goes out.</li>\n</ul>\n",
          "featureGraphic": "featureGraphic_TO48P1raWMNKUe76iDjL3wcSA6JNsnVrWm0h0N5Fp-M=.png",
          "icon": "icon_Q7_fv1WvW3U9ztLz2soKy73aduy8pLD3EycJcYgLxqQ=.png",
          "name": "Campfire",
          "phoneScreenshots": [
            "1.png",
            "2.png",
            "3.png",
            "4.png",
            "5.png"
          ],
          "summary": "Host a group chat from your phone. Others join from any browser. No internet",
          "whatsNew": "\u2022 Built reproducibly, so the F-Droid and GitHub versions are the same app with the same signature, and you can update from either.\n"
        }
      }
    },
