      "added": 1793729827000,
      "packageName": "com.prempoddar.oaf",
      "lastUpdated": 1793729827000,
      "localized": {
        "en-US": {
          "description": "<p><b>OAF opens almost any file on your phone, and edits most of them.</b> PDFs, Word and Excel, slides, books, archives, pictures, music and video, in one quiet, fast app. Nothing is uploaded; it all happens on your phone.</p>\n<ul>\n<li><b>Documents:</b> read, annotate, fill and sign PDFs; edit Word and Excel; view slides.</li>\n<li><b>Books and text:</b> EPUB, Markdown and code with highlighting.</li>\n<li><b>Pictures:</b> crop, filters, drawing and text, blur faces, remove the background, copy text out of a photo; swipe between photos.</li>\n<li><b>Music and video</b> with a proper player, picture-in-picture and swipe between videos.</li>\n<li><b>Archives:</b> open and make zip, 7z and tar; open rar.</li>\n<li><b>A real file manager:</b> search inside documents, a 30-day bin, storage clean-up, previews, and network drives (SMB, SFTP, FTP, WebDAV).</li>\n<li><b>Apps:</b> share installed apps, even split ones, as one installable APK.</li>\n<li><b>Share over Wi-Fi</b> with a built-in FTP server.</li>\n</ul>\n",
          "featureGraphic": "featureGraphic_9bSReFhrORGRdeN5Yi1MpOOAgXDEplwK2ZxsAOgUEnI=.png",
          "icon": "icon_Jym0ur35xdoaE4EmSQjyqFht-8toXB43dcIRaNT_1ZE=.png",
          "name": "OAF",
          "phoneScreenshots": [
            "1.png",
            "2.png",
            "3.png",
            "4.png",
            "5.png",
            "6.png",
            "7.png",
            "8.png"
          ],
          "summary": "Open and edit almost any file: PDFs, Office, books, archives, media",
          "whatsNew": "\u2022 Back goes back where you came from: when another app opens a file or an APK with OAF, going back now returns to that app, even after installing the APK.\n"
        }
      }
    },
    {
